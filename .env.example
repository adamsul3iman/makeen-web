# Copy to .env.local and fill in your Supabase project keys.
# https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by Next.js API routes after public table grants are
# revoked. Never prefix this key with NEXT_PUBLIC_ or expose it to the client.
# SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for `npm run migrate` (db/migrate.mjs).
# Prefer the IPv4 Session pooler string (Dashboard -> Database -> Connection string).
# The direct db.<ref>.supabase.co host is IPv6-only on newer projects.
# DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# Server-only shared secret. Gated RPC functions (provision/authenticate/
# update credentials/delete store) compare the caller-supplied token against
# this value, so they can never be invoked directly through the public
# PostgREST endpoint. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PLATFORM_OPS_SECRET=

# Server-only HMAC secret for the HttpOnly admin session cookie (F2).
# Sessions are invalidated by rotating this. When empty, a random per-process
# secret is used (sessions die on server restart).
# ADMIN_SESSION_SECRET=
