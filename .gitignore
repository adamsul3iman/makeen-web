# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/.artifacts
/.codex-artifacts

# local data imports and investigation scratchpads
/*.xlsx
/*.xls
/scripts/_*.mjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# nuclear operational scripts (manual execution only — never commit)
/db/factory_reset.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server output
/dev.log

# Electron & Desktop App Builds
dist-electron/
dist-electron-final/
/dist-final/
/dist-final-*/

# Python Environment
.venv/